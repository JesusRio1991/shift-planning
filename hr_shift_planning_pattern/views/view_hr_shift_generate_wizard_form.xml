<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_shift_generate_wizard_form" model="ir.ui.view">
        <field name="name">hr.shift.generate.wizard.form</field>
        <field name="model">hr.shift.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Shifts">
                <group>
                    <field name="employee_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button string="Generate"
                            type="object"
                            name="action_generate_shifts"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action del wizard (por si no la tienes) -->
    <record id="action_hr_shift_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Shifts</field>
        <field name="res_model">hr.shift.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
