<odoo>
    <!-- Acción para ver turnos -->
    <record id="action_hr_shift_planning_shift" model="ir.actions.act_window">
        <field name="name">Turnos</field>
        <field name="res_model">hr.shift.planning.shift</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menú para acceder a los turnos -->
    <menuitem id="menu_hr_shift_planning_root" name="Turnos" />
    <menuitem id="menu_hr_shift_planning_shifts"
        name="Turnos de Empleados"
        parent="menu_hr_shift_planning_root"
        action="action_hr_shift_planning_shift" />

    <!-- Vista lista de turnos -->
    <record id="view_hr_shift_tree" model="ir.ui.view">
        <field name="name">hr.shift.planning.shift.tree</field>
        <field name="model">hr.shift.planning.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id" />
                <field name="template_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_hr_shift_calendar" model="ir.ui.view">
        <field name="name">hr.shift.calendar</field>
        <field name="model">hr.shift.planning.shift</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Turnos"
                      date_start="shift_template_id.date_start"
                      date_stop="shift_template_id.date_end">
                <field name="employee_id"/>
                <field name="shift_template_id"/>
            </calendar>
        </field>
    </record>
    

    <menuitem id="menu_hr_shift_root" name="Turnos" sequence="10" />

    <menuitem id="menu_hr_shift_lines"
        name="Calendario de Turnos"
        parent="menu_hr_shift_root"
        action="action_hr_shift_line_calendar" />

    <record id="action_hr_shift_line_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de Turnos</field>
        <field name="res_model">hr.shift.planning.line</field>
        <field name="view_mode">calendar,tree,form</field>
    </record>


</odoo>