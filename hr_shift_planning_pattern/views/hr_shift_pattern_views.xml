<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action + Menu -->
    <record id="action_hr_shift_pattern" model="ir.actions.act_window">
        <field name="name">Shift Patterns</field>
        <field name="res_model">hr.shift.pattern</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create patterns (6+2, etc.) and generate shifts.
            </p>
        </field>
    </record>

    <!-- Add menu under 'Shift planning' if that menu exists; fallback under Employees -->
    <menuitem id="menu_hr_shift_pattern_root" name="Shift Patterns" sequence="20" parent="hr_shift_planning.menu_hr_shift_planning_root" />
    <act_window id="action_hr_shift_pattern_bind" name="Shift Patterns" 
                res_model="hr.shift.pattern" src_model="" view_mode="tree,form" target="current"/>

    <record id="view_hr_shift_pattern_tree" model="ir.ui.view">
        <field name="name">hr.shift.pattern.tree</field>
        <field name="model">hr.shift.pattern</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="cycle_length"/>
                <field name="start_date"/>
                <field name="employee_id"/>
                <field name="auto_generate"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_shift_pattern_form" model="ir.ui.view">
        <field name="name">hr.shift.pattern.form</field>
        <field name="model">hr.shift.pattern</field>
        <field name="arch" type="xml">
            <form string="Shift Pattern">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="cycle_length"/>
                        <field name="start_date"/>
                        <field name="employee_id"/>
                        <field name="auto_generate"/>
                    </group>
                    <notebook>
                        <page string="Pattern lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="day_number"/>
                                    <field name="shift_template_id"/>
                                    <field name="is_rest"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="generate_shifts" type="object" string="Generate shifts" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bind action to menu -->
    <record id="ir_action_window_hr_shift_pattern" model="ir.actions.act_window">
        <field name="name">Shift Patterns</field>
        <field name="res_model">hr.shift.pattern</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hr_shift_pattern" name="Shift Patterns" parent="hr_shift_planning.menu_hr_shift_planning_root" action="ir_action_window_hr_shift_pattern" sequence="10"/>
</odoo>
