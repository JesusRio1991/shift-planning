<odoo>
    <record id="view_hr_shift_planning_pattern_form" model="ir.ui.view">
        <field name="name">hr.shift.planning.pattern.form</field>
        <field name="model">hr.shift.planning.pattern</field>
        <field name="arch" type="xml">
            <form string="Patrón de turnos">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <notebook>
                        <page string="Líneas">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="day_number"/>
                                    <field name="is_rest"/>
                                    <field name="shift_template_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_shift_planning_pattern_tree" model="ir.ui.view">
        <field name="name">hr.shift.planning.pattern.tree</field>
        <field name="model">hr.shift.planning.pattern</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_hr_shift_planning_pattern" model="ir.actions.act_window">
        <field name="name">Patrones de turnos</field>
        <field name="res_model">hr.shift.planning.pattern</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hr_shift_planning_pattern"
              name="Patrones de turnos"
              parent="hr.menu_hr_working_time"
              action="action_hr_shift_planning_pattern"/>
</odoo>
