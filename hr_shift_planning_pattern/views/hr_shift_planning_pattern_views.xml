<odoo>
    <!-- Tree view -->
    <record id="view_hr_shift_planning_pattern_tree" model="ir.ui.view">
        <field name="name">hr.shift.planning.pattern.tree</field>
        <field name="model">hr.shift.planning.pattern</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="cycle_length" />
                <field name="start_date" />
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_hr_shift_planning_pattern_form" model="ir.ui.view">
        <field name="name">hr.shift.planning.pattern.form</field>
        <field name="model">hr.shift.planning.pattern</field>
        <field name="arch" type="xml">
            <form string="Patrón de Turno">
                <button name="generate_shifts_for_employees"
                    type="object"
                    string="Generar turnos para empleados"
                    class="btn-primary mb-2" />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="cycle_length" />
                        <field name="start_date" />
                    </group>
                    <notebook>
                        <page string="Líneas del patrón">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="day_number" />
                                    <field name="shift_template_id" />
                                    <field name="is_rest" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>