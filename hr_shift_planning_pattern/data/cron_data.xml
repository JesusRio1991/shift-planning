<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_generate_shift_patterns" model="ir.cron">
        <field name="name">Generate shift patterns</field>
        <field name="model_id" ref="model_hr_shift_pattern"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_all_patterns()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">False</field> <!-- por defecto desactivado -->
    </record>
</odoo>
